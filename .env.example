# Copiá este archivo como .env.local y completá con los datos de tu proyecto Supabase
# (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor (sin NEXT_PUBLIC_): nunca llegan al navegador.
# Project Settings → JWT Keys → "Legacy JWT secret"
SUPABASE_JWT_SECRET=
# Project Settings → API Keys → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# Código que la familia escribe para entrar (ej: PUERTOPLATA27)
FAMILY_CODE=
